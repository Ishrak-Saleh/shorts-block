{
  "manifest_version": 3,
  "name": "ShortsBlock",
  "version": "1.0",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_ruleset",
        "enabled": true,
        "path": "dnr_rules.json"
        
      }
    ]
  },
  "web_accessible_resources": [
  {
    "resources": ["blocked.html"],
    "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"]
  }
],
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"],
      "js": ["content.js"]
    }
  ]
}